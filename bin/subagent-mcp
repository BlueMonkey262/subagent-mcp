#!/usr/bin/env bash
# subagent-mcp: launch Claude Code with the subagent-mcp server's channel enabled and the
# status-line mod loaded, so you don't have to pass --dangerously-load-development-channels.
#
#   subagent-mcp [any claude arguments]      e.g. subagent-mcp --resume
#   subagent-mcp nim set-key [KEY]           add the NVIDIA NIM endpoint with your API key
#   subagent-mcp endpoint add NAME URL --model ID[=alias] [--key KEY]   add any OpenAI-compatible endpoint
#   subagent-mcp endpoint list|remove NAME
#   subagent-mcp antigravity doctor|vendor <agent-config> [--force]     audit or vendor Antigravity definitions
#   subagent-mcp status                      endpoints, litellm and proxy state
#   subagent-mcp wait <agent...> [--any] [--timeout S]   block until agents settle (exit code = outcome)
#   subagent-mcp events [--follow]           one JSON line per settled turn (tails the results log)
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
PORT="${SUBAGENT_MCP_NIM_PORT:-4131}"

case "${1:-}" in
nim)
    exec node "$ROOT/bin/endpoints.mjs" "$@"
    ;;
endpoint)
    shift
    exec node "$ROOT/bin/endpoints.mjs" "$@"
    ;;
antigravity)
    shift
    exec node "$ROOT/bin/agents.mjs" "$@"
    ;;
wait|events)
    exec node "$ROOT/bin/watch.mjs" "$@"
    ;;
status)
    node "$ROOT/bin/endpoints.mjs" list
    command -v litellm >/dev/null && echo "litellm: installed" || echo "litellm: missing (pip install 'litellm[proxy]')"
    curl -s -o /dev/null "http://127.0.0.1:${PORT}/health/liveliness" \
        && echo "proxy: running on :${PORT}" || echo "proxy: not running (starts with the MCP server)"
    exit 0
    ;;
esac

command -v claude >/dev/null || { echo "subagent-mcp: 'claude' not found on PATH" >&2; exit 1; }

# Load the status-line mod (append to any existing plugin dirs), unless it is already listed: the
# desktop app setup in SETUP.md puts the same folder in ~/.claude/settings.json.
MOD="$ROOT/mod/subagent-strip"
MOD_REAL="$(cd "$MOD" && pwd -P)"
listed=0
IFS=':' read -r -a plugin_dirs <<< "${CLAUDE_CODE_PLUGIN_DIRS:-}"
for dir in ${plugin_dirs[@]+"${plugin_dirs[@]}"}; do
    # Compare physical paths, so a trailing slash, ~ or a symlinked checkout still counts as listed.
    dir="${dir/#\~/$HOME}"
    [ "$(cd "$dir" 2>/dev/null && pwd -P)" = "$MOD_REAL" ] && listed=1
done
[ "$listed" = 1 ] || export CLAUDE_CODE_PLUGIN_DIRS="$MOD${CLAUDE_CODE_PLUGIN_DIRS:+:$CLAUDE_CODE_PLUGIN_DIRS}"

exec claude --dangerously-load-development-channels server:subagent-mcp "$@"
